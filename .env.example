# Copy this file to .env and fill in your Alpaca PAPER trading keys from
# https://app.alpaca.markets (make sure you're looking at the paper account's
# keys, not the live account's -- Alpaca shows both). run_live_alpaca.py loads
# this automatically if python-dotenv is installed. Never commit a real .env
# file -- it's already in .gitignore.

ALPACA_API_KEY=your-paper-api-key-id
ALPACA_SECRET_KEY=your-paper-secret-key
